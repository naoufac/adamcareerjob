# ADAMJOBS environment. Copy to .env and fill. Never commit .env.

# --- Runtime ---
NODE_ENV=development
WEB_PORT=8780
API_PORT=8781
APP_BASE_URL=http://localhost:8780
API_BASE_URL=http://localhost:8781
# Browser-facing API URL (public, set to your api subdomain in prod):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8781

# --- Database (Postgres) ---
POSTGRES_USER=adam
POSTGRES_PASSWORD=change_me
POSTGRES_DB=adamjobs
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-visible port for migrations / psql (bound to 127.0.0.1 only):
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://adam:change_me@postgres:5432/adamjobs

# --- Cache / Queue (Redis) ---
REDIS_URL=redis://redis:6379

# --- Auth ---
# Session signing secret (generate: openssl rand -hex 32)
AUTH_JWT_SECRET=replace_with_long_random_hex
AUTH_COOKIE_NAME=adam_session
# Composio OAuth (https://dashboard.composio.dev)
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_REDIRECT_URL=http://localhost:8781/auth/composio/callback
# Toolkit slugs enabled for login (Composio names):
COMPOSIO_LOGIN_TOOLKITS=google,linkedin

# --- LLM (Z.AI GLM-5.2) ---
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.2

# --- Job search APIs (later milestones) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOB_BANK_GC_BASE=https://www.jobbank.gc.ca

# --- Web research ---
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
